{
  "name": "dsh-modmenu",
  "version": "0.3.0",
  "description": "DSH 的模组菜单：插件、工具、脚本，一个面板看完。Mod menu for DeepSeek Harness: plugins, tools and scripts in one panel.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-manager",
    "tools",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sail-ZF/dsh-modmenu.git"
  },
  "homepage": "https://github.com/Sail-ZF/dsh-modmenu#readme",
  "bugs": {
    "url": "https://github.com/Sail-ZF/dsh-modmenu/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
